name: pipeline

on:
  push:
    branches:
      - main

jobs:
  build-and-push-images:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      packages: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to ghcr
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push node docker image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: docker/production/Dockerfile
          push: true
          tags: |
            ghcr.io/${{ github.repository_owner }}/atheonworks:latest
            ghcr.io/${{ github.repository_owner }}/atheonworks:${{ github.sha }}
          cache-from: type=gha,scope=prod-app-cache
          cache-to: type=gha,mode=max,scope=prod-app-cache
  deploy:
    runs-on: ubuntu-latest

    permissions:
      contents: read
      packages: read

    needs:
      - build-and-push-images

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Start SSH agent and add private key
        uses: shimataro/ssh-key-action@v2
        with:
          key: ${{ secrets.DOCKER_SSH_PRIVATE_KEY }}
          known_hosts: ${{ secrets.KNOWN_HOSTS }}

      - name: Set up Docker SSH context
        run: |
          docker context create droplet --docker "host=ssh://${{ secrets.DOCKER_USER }}@${{ secrets.DOCKER_HOST }}"
          docker context use droplet

      - name: Log in to GHCR on remote server
        run: |
          echo "${{ secrets.GITHUB_TOKEN }}" | \
          docker --context droplet login ghcr.io \
            -u ${{ github.repository_owner }} \
            --password-stdin

      - name: Pull Atheonworks image
        uses: nick-fields/retry@v3
        with:
          timeout_minutes: 2
          max_attempts: 12
          retry_wait_seconds: 10
          command: |
            docker --context droplet pull ghcr.io/${{ github.repository_owner }}/atheonworks:${{ github.sha }}

      - name: Deploy Docker stack with environment variables
        env:
          GITHUB_SHA: ${{ github.sha }}
          RESEND_API_KEY: ${{ secrets.RESEND_API_KEY }}
        run: |
          docker stack deploy \
            --compose-file docker-stack.yml \
            --resolve-image always \
            --with-registry-auth \
            atheonworks
